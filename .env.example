# Supabase public browser configuration. Never put service-role keys in VITE_ variables.
VITE_SUPABASE_URL=https://xcipemtyclinuyaadgxy.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# Driver allow-list (comma-separated emails). Create each driver in Supabase Auth first.
VITE_DRIVER_EMAILS=

# ---- Build target (server env var; set ONLY on the console Vercel project) ----
# Leave unset for the public storefront build (-> dist).
# Set to 'console' on the CONSOLE project only: builds the staff console
# from console.html into dist-console.
BUILD_TARGET=

# ---- Server-only (Vercel Environment Variables). Never prefix these with VITE_. ----
# Admin console login, checked by /api/admin/* (no Supabase user needed).
ADMIN_EMAIL=
ADMIN_PASSWORD=
# 32+ random characters: openssl rand -base64 48
ADMIN_SESSION_SECRET=
# Supabase -> Project Settings -> API -> service_role key
SUPABASE_SERVICE_ROLE_KEY=

# ---- Paystack (Phase 3, server-only; leave empty until checkout goes live) ----
# Public key is safe in the browser; the secret key NEVER is.
VITE_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
