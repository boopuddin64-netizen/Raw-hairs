# RAW HAIRS environment template
# Copy to .env.local for local development. Never commit real values.
# Server-only secrets (do not prefix these with VITE_):
DATABASE_URL=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=

# Browser-safe Firebase configuration (Firebase Storage is deferred):
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=

# Paystack public key is safe for browser use:
VITE_PAYSTACK_PUBLIC_KEY=

# Optional; leave empty to use same-origin /api routes:
VITE_API_BASE_URL=
