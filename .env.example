# Supabase public browser configuration. Never put service-role keys in VITE_ variables.
VITE_SUPABASE_URL=https://xcipemtyclinuyaadgxy.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# Driver allow-list (comma-separated emails). Create each driver in Supabase Auth first.
VITE_DRIVER_EMAILS=

# ---- Server-only (Vercel Environment Variables). Never prefix these with VITE_. ----
# Admin console login, checked by /api/admin/* (no Supabase user needed).
# Fill in Vercel project settings; do not commit real values here.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# 32+ random characters: openssl rand -base64 48
ADMIN_SESSION_SECRET=
# Supabase -> Project Settings -> API -> service_role key
SUPABASE_SERVICE_ROLE_KEY=

# ---- Payments (server-only, added in the checkout phase) ----
# Paystack secret key (TEST key in development: sk_test_...). Never prefix with VITE_.
PAYSTACK_SECRET_KEY=
# Comma-separated IPs Paystack webhooks come from (e.g. 52.31.139.14, ...).
# Signature verification is mandatory; this list is defence in depth.
PAYSTACK_WEBHOOK_IPS=
