# Supabase public browser configuration. Never put service-role keys in VITE_ variables.
VITE_SUPABASE_URL=https://xcipemtyclinuyaadgxy.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# Staff allow-lists (comma-separated emails). Used until app_metadata.role is set in Supabase.
# Create each user in Supabase Auth (Authentication → Users) with email + password first.
VITE_ADMIN_EMAILS=owner@example.com
VITE_DRIVER_EMAILS=driver1@example.com,driver2@example.com
